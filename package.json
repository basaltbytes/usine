{
  "name": "usine",
  "private": true,
  "description": "An agent-agnostic software factory: an engine where loops — trigger → agent-run automations authored as files in git — run against many repos from one headless orchestrator.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:packed-install": "node scripts/check-packed-install.mjs",
    "test": "node --test scripts/release/*.test.mjs && turbo run test --concurrency=1",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm build && pnpm stage publish -r --tag latest --no-git-checks && node scripts/release/tag.mjs",
    "prerelease:version": "node scripts/prerelease-versions.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}

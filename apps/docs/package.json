{
  "name": "@usine/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The usine documentation site, built with Astro Starlight. Not published to npm; deployed to docs.usine.dev.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm test && pnpm openapi:generate && astro build && node --test test/built-navigation.mjs test/built-quickstart.mjs test/llms.build.mjs",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "deploy": "wrangler deploy",
    "openapi:generate": "node --experimental-strip-types openapi.mjs",
    "openapi:check": "node --experimental-strip-types openapi.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.8",
    "hast-util-from-html": "2.1.0",
    "hast-util-to-string": "3.0.1",
    "lucode-starlight": "1.0.0",
    "pele": "1.13.0",
    "starlight-links-validator": "0.27.0",
    "starlight-llms-txt": "0.12.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@usine/config": "workspace:*",
    "@usine/core": "workspace:*",
    "@usine/expression": "workspace:*",
    "@usine/orchestrator": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}

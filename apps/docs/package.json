{
  "name": "@usine/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The usine documentation site, built with Astro Starlight. Not published to npm; deployed to docs.usine.dev.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm test && pnpm openapi:generate && astro build",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "deploy": "wrangler deploy",
    "openapi:generate": "node --experimental-strip-types openapi.mjs",
    "openapi:check": "node --experimental-strip-types openapi.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "@mermaid-js/layout-elk": "1.0.1",
    "astro": "7.4.4",
    "astro-mermaid": "2.2.0",
    "lucode-starlight": "1.0.0",
    "mermaid": "12.2.0",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@usine/config": "workspace:*",
    "@usine/core": "workspace:*",
    "@usine/expression": "workspace:*",
    "@usine/orchestrator": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}

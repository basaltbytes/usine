{
  "name": "@usine/server",
  "version": "0.3.0",
  "description": "The usine orchestrator as a headless server: a thin CLI over @usine/orchestrator that serves the web UI.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "apps/server"
  },
  "bin": {
    "usine": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-web.mjs",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@usine/config": "workspace:*",
    "@usine/core": "workspace:*",
    "@usine/durable": "workspace:*",
    "@usine/engine": "workspace:*",
    "@usine/expression": "workspace:*",
    "@usine/github": "workspace:*",
    "@usine/orchestrator": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@usine/executor": "workspace:*",
    "@usine/tsconfig": "workspace:*",
    "@usine/web": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}

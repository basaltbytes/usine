# The image of each attempt's container on an SSH worker with Docker. The
# executor mounts the attempt's checkout and harness logins read-write, and its
# cached clone and credential directory read-only, and runs every command of
# the attempt with `docker exec` as the usine user. Run `pnpm worker-image:generate`
# to update harness packages from the descriptors in @usine/agents/harness.
FROM debian:trixie-slim

# The Node.js major version of the image and of the worker machine:
# ../hetzner/render-cloud-init.sh puts it in ../hetzner/cloud-init.yaml.
ARG NODE_MAJOR=22
# Generated by scripts/worker-image/generate.mjs: pnpm from the root
# packageManager field, the harness packages from their descriptors.
ARG PNPM_VERSION=11.20.0
ARG HARNESS_PACKAGES="@anthropic-ai/claude-code@2.1.311 @openai/codex@0.164.0"
# The worker's SSH user ID, so that files the attempt writes in its mounted
# checkout belong to that user. Preflight compares the two.
ARG USINE_UID=1000

RUN set -eu; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential bubblewrap ca-certificates chromium curl git gnupg iproute2 jq lsof procps tini; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gh nodejs; \
    rm -rf /var/lib/apt/lists/*

# The boxd CLI, signed out, so that an attempt can read `boxd <command> --help`.
# boxd serves only its latest binary, at a URL without a version, and its
# installer always installs that one; this step downloads it the way the
# installer does, and fails when boxd has replaced the pinned version. The
# checksums are those of https://boxd.sh/downloads/cli/latest-linux-<arch>.json.
ARG BOXD_VERSION=0.3.3
ARG BOXD_SHA256_AMD64=38371394b448850f32a2b6b297fe5141c5d8e2afd40037e8d4c93a0a00b0d35f
ARG BOXD_SHA256_ARM64=86479f787620fd970c10453cdeb15f871b7ce818e559925e3d6ebfc3c2052b13
RUN set -eu; \
    arch=$(dpkg --print-architecture); \
    case "$arch" in \
      amd64) sum=${BOXD_SHA256_AMD64} ;; \
      arm64) sum=${BOXD_SHA256_ARM64} ;; \
      *) echo "boxd has no Linux binary for $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/boxd "https://boxd.sh/downloads/cli/boxd-linux-$arch"; \
    echo "$sum  /usr/local/bin/boxd" | sha256sum -c - \
      || { echo "boxd no longer serves ${BOXD_VERSION}: update BOXD_VERSION and the checksums" >&2; exit 1; }; \
    chmod 0755 /usr/local/bin/boxd; \
    [ "$(BOXD_TELEMETRY=0 boxd --version)" = "boxd ${BOXD_VERSION}" ]

RUN npm install -g "pnpm@${PNPM_VERSION}" ${HARNESS_PACKAGES} \
 && npm cache clean --force

# The harnesses write sessions and settings under their directories; the
# executor mounts only the login files inside them.
RUN useradd --uid "${USINE_UID}" --create-home --shell /bin/bash usine \
 && install -d -o usine -g usine -m 0700 \
      /home/usine/.claude /home/usine/.codex /home/usine/.cache /home/usine/.config

COPY --chmod=0755 container-init.sh /usr/local/bin/usine-container-init

# The attempt's checkout is a bind mount on another filesystem than the home
# directory, so pnpm would create its store in the checkout (#581). pnpm 11
# reads pnpm_config_store_dir, and earlier versions npm_config_store_dir.
ENV DISABLE_AUTOUPDATER=1 \
    BOXD_TELEMETRY=0 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    GH_NO_UPDATE_NOTIFIER=1 \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium \
    TURBO_CACHE_DIR=/home/usine/.cache/turbo \
    COREPACK_HOME=/home/usine/.cache/node/corepack \
    npm_config_store_dir=/home/usine/.local/share/pnpm/store \
    pnpm_config_store_dir=/home/usine/.local/share/pnpm/store

USER usine
WORKDIR /home/usine

# Corepack doesn't use HTTPS_PROXY, so it can't download pnpm behind the
# gateway; `corepack pnpm` runs this cached version.
RUN COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack install -g "pnpm@${PNPM_VERSION}"

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/usine-container-init"]
CMD ["sleep", "infinity"]

{
  "name": "@usine/orchestrator",
  "version": "0.3.0",
  "description": "The embeddable usine composition: the full engine as an Effect layer, startable in-process.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/orchestrator"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./board/projection": {
      "types": "./dist/board/projection.d.ts",
      "default": "./dist/board/projection.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./current-instance": {
      "types": "./dist/current-instance/current-instance.d.ts",
      "default": "./dist/current-instance/current-instance.js"
    },
    "./exe-dev": {
      "types": "./dist/exe-dev.d.ts",
      "default": "./dist/exe-dev.js"
    },
    "./idle-triggers": {
      "types": "./dist/idle-triggers.d.ts",
      "default": "./dist/idle-triggers.js"
    },
    "./label-reconciler": {
      "types": "./dist/label-reconciler.d.ts",
      "default": "./dist/label-reconciler.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./operator": {
      "types": "./dist/operator/operator.d.ts",
      "default": "./dist/operator/operator.js"
    },
    "./operator/http": {
      "types": "./dist/operator/http.d.ts",
      "default": "./dist/operator/http.js"
    },
    "./orchestrator": {
      "types": "./dist/orchestrator.d.ts",
      "default": "./dist/orchestrator.js"
    },
    "./polling-triggers": {
      "types": "./dist/polling-triggers.d.ts",
      "default": "./dist/polling-triggers.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./schedule-triggers": {
      "types": "./dist/schedule-triggers.d.ts",
      "default": "./dist/schedule-triggers.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./ssh": {
      "types": "./dist/ssh.d.ts",
      "default": "./dist/ssh.js"
    },
    "./worker-status": {
      "types": "./dist/worker-status.d.ts",
      "default": "./dist/worker-status.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration/polling-triggers.test.ts",
    "test:integration:agent": "vitest run test/integration/agent-run.test.ts",
    "test:exe-dev": "vitest run test/integration/exe-dev-worker.test.ts",
    "test:ssh": "vitest run --disable-console-intercept test/integration/ssh-worker.test.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@usine/config": "workspace:*",
    "@usine/core": "workspace:*",
    "@usine/durable": "workspace:*",
    "@usine/engine": "workspace:*",
    "@usine/executor": "workspace:*",
    "@usine/expression": "workspace:*",
    "@usine/github": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@usine/agents": "workspace:*",
    "@usine/gateway": "workspace:*",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

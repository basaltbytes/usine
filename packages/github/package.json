{
  "name": "@usine/github",
  "version": "0.1.0",
  "description": "GitHub App authentication, installation discovery, project coverage, and scoped token minting for usine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/github"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-secrets": {
      "types": "./dist/local-secrets.d.ts",
      "default": "./dist/local-secrets.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration/github-app.test.ts"
  },
  "dependencies": {
    "@usine/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

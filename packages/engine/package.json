{
  "name": "@usine/engine",
  "version": "0.0.1",
  "description": "The usine run engine: event ledger, dedup/supersede/revoke, run scheduling, durable-execution seam, SQLite store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local-sqlite": {
      "types": "./dist/database/local-sqlite.d.ts",
      "default": "./dist/database/local-sqlite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@usine/core": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@usine/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

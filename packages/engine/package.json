{
  "name": "@usine/engine",
  "version": "0.3.0",
  "description": "The usine run engine: event ledger, dedup/supersede/revoke, run scheduling, durable-execution seam, SQLite store.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./cycle-budget": {
      "types": "./dist/cycle-budget/cycle-budget.d.ts",
      "default": "./dist/cycle-budget/cycle-budget.js"
    },
    "./engine": {
      "types": "./dist/engine/engine.d.ts",
      "default": "./dist/engine/engine.js"
    },
    "./local-sqlite": {
      "types": "./dist/database/local-sqlite.d.ts",
      "default": "./dist/database/local-sqlite.js"
    },
    "./loop-control": {
      "types": "./dist/loop-control/loop-control.d.ts",
      "default": "./dist/loop-control/loop-control.js"
    },
    "./run-reader": {
      "types": "./dist/run-reader/run-reader.d.ts",
      "default": "./dist/run-reader/run-reader.js"
    },
    "./step-executor": {
      "types": "./dist/step-executor.d.ts",
      "default": "./dist/step-executor.js"
    },
    "./transcript": {
      "types": "./dist/transcript.d.ts",
      "default": "./dist/transcript.js"
    },
    "./database": {
      "types": "./dist/database/database.d.ts",
      "default": "./dist/database/database.js"
    },
    "./item-projection": {
      "types": "./dist/item-projection/item-projection.d.ts",
      "default": "./dist/item-projection/item-projection.js"
    },
    "./repository-label-projection": {
      "types": "./dist/repository-label-projection/repository-label-projection.d.ts",
      "default": "./dist/repository-label-projection/repository-label-projection.js"
    },
    "./cursor": {
      "types": "./dist/cursor/cursor.d.ts",
      "default": "./dist/cursor/cursor.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@usine/core": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@usine/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

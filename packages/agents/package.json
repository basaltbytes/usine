{
  "name": "@usine/agents",
  "version": "0.4.0",
  "description": "The usine agent layer: Claude Code, Codex, and Pi child backends, Attempt prompts, and harness preflight.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/agents"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./pi": {
      "types": "./dist/pi/pi.d.ts",
      "default": "./dist/pi/pi.js"
    },
    "./child-host": {
      "types": "./dist/child-host/child-host.d.ts",
      "default": "./dist/child-host/child-host.js"
    },
    "./children": {
      "types": "./dist/pi/children.d.ts",
      "default": "./dist/pi/children.js"
    },
    "./claude": {
      "types": "./dist/pi/claude.d.ts",
      "default": "./dist/pi/claude.js"
    },
    "./codex": {
      "types": "./dist/pi/codex/codex.d.ts",
      "default": "./dist/pi/codex/codex.js"
    },
    "./openai-prices": {
      "types": "./dist/openai-prices.d.ts",
      "default": "./dist/openai-prices.js"
    },
    "./pi/authentication": {
      "types": "./dist/pi/authentication.d.ts",
      "default": "./dist/pi/authentication.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./preflight": {
      "types": "./dist/preflight/preflight.d.ts",
      "default": "./dist/preflight/preflight.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.conformance.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration:claude": "vitest run test/integration/claude.test.ts",
    "test:integration:codex": "vitest run test/integration/codex.test.ts",
    "test:integration:pi": "vitest run test/integration/pi.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@usine/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@pwrdrvr/codex-app-server-protocol": "0.159.2",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@usine/agents",
  "version": "0.7.0",
  "description": "The usine agent layer: Claude Code, Codex, and Pi child backends, Attempt prompts, and harness preflight.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/agents"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./pi": {
      "types": "./dist/harness/pi/pi.d.ts",
      "default": "./dist/harness/pi/pi.js"
    },
    "./child-host": {
      "types": "./dist/child-host/child-host.d.ts",
      "default": "./dist/child-host/child-host.js"
    },
    "./child-host/owner": {
      "types": "./dist/child-host/owner.d.ts",
      "default": "./dist/child-host/owner.js"
    },
    "./continuation": {
      "types": "./dist/harness/continuation.d.ts",
      "default": "./dist/harness/continuation.js"
    },
    "./children": {
      "types": "./dist/harness/children.d.ts",
      "default": "./dist/harness/children.js"
    },
    "./claude": {
      "types": "./dist/harness/claude/claude.d.ts",
      "default": "./dist/harness/claude/claude.js"
    },
    "./codex": {
      "types": "./dist/harness/codex/codex.d.ts",
      "default": "./dist/harness/codex/codex.js"
    },
    "./openai-prices": {
      "types": "./dist/openai-prices.d.ts",
      "default": "./dist/openai-prices.js"
    },
    "./pi/authentication": {
      "types": "./dist/harness/pi/authentication.d.ts",
      "default": "./dist/harness/pi/authentication.js"
    },
    "./pi/refusal": {
      "types": "./dist/harness/pi/refusal.d.ts",
      "default": "./dist/harness/pi/refusal.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./preflight": {
      "types": "./dist/preflight/preflight.d.ts",
      "default": "./dist/preflight/preflight.js"
    },
    "./harness": {
      "types": "./dist/harness/catalog.d.ts",
      "default": "./dist/harness/catalog.js"
    },
    "./harness/contract": {
      "types": "./dist/harness/contract.d.ts",
      "default": "./dist/harness/contract.js"
    },
    "./harness/node": {
      "types": "./dist/harness/node.d.ts",
      "default": "./dist/harness/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --experimental-strip-types build-worker.mjs --dist && tsc -b",
    "check": "node --experimental-strip-types build-worker.mjs && effect-tsgo tsc -p tsconfig.check.json && effect-tsgo tsc -p tsconfig.conformance.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration:claude": "vitest run test/integration/claude.test.ts",
    "test:integration:codex": "vitest run test/integration/codex.test.ts",
    "test:integration:pi": "vitest run test/integration/pi.test.ts",
    "codex:generate": "node --experimental-strip-types scripts/codex/generate.mjs",
    "codex:check": "node --experimental-strip-types scripts/codex/generate.mjs --check",
    "codex:check:upstream": "node --experimental-strip-types scripts/codex/generate.mjs --check --upstream",
    "codex:update": "node --experimental-strip-types scripts/codex/generate.mjs --upstream"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@usine/core": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@pwrdrvr/codex-app-server-protocol": "0.164.0",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

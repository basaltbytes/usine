{
  "name": "@usine/agents",
  "version": "0.3.0",
  "description": "The usine agent layer: Pi parent adapter, subagents extension, team roster and brain specs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/agents"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./pi": {
      "types": "./dist/pi/pi.d.ts",
      "default": "./dist/pi/pi.js"
    },
    "./children": {
      "types": "./dist/pi/children.d.ts",
      "default": "./dist/pi/children.js"
    },
    "./claude": {
      "types": "./dist/pi/claude.d.ts",
      "default": "./dist/pi/claude.js"
    },
    "./codex": {
      "types": "./dist/pi/codex/codex.d.ts",
      "default": "./dist/pi/codex/codex.js"
    },
    "./pi/live": {
      "types": "./dist/pi/live.d.ts",
      "default": "./dist/pi/live.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./preflight": {
      "types": "./dist/preflight/preflight.d.ts",
      "default": "./dist/preflight/preflight.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.conformance.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration:codex": "vitest run test/integration/codex.test.ts",
    "test:integration:pi": "vitest run test/integration/pi.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@usine/core": "workspace:*",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@pwrdrvr/codex-app-server-protocol": "0.144.0",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

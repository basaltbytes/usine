{
  "protocol": "claude-sdk",
  "harnessVersion": "2.1.311",
  "model": "claude-sonnet-5-5",
  "scenario": "early-exit",
  "environment": {
    "HOME": "$HOME",
    "PATH": "$PATH",
    "CODEX_HOME": "$CODEX_HOME",
    "ANTHROPIC_BASE_URL": "$ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN": "$USINE_GATEWAY_TOKEN",
    "USINE_GATEWAY_TOKEN": "$USINE_GATEWAY_TOKEN"
  },
  "entries": [
    {
      "type": "expect_outbound",
      "port": "claude:1",
      "payload": {
        "method": "open",
        "options": {
          "allowDangerouslySkipPermissions": true,
          "cwd": "$WORKTREE",
          "env": {
            "HOME": "$HOME",
            "PATH": "$PATH",
            "CODEX_HOME": "$CODEX_HOME",
            "ANTHROPIC_BASE_URL": "$ANTHROPIC_BASE_URL",
            "ANTHROPIC_AUTH_TOKEN": "$USINE_GATEWAY_TOKEN",
            "USINE_GATEWAY_TOKEN": "$USINE_GATEWAY_TOKEN"
          },
          "model": "claude-sonnet-5-5",
          "pathToClaudeCodeExecutable": "claude",
          "permissionMode": "bypassPermissions",
          "persistSession": true,
          "settingSources": ["user"],
          "effort": "low",
          "thinking": { "type": "adaptive" },
          "hooks": {
            "PreToolUse": [{ "hooks": [null], "timeout": 86400 }],
            "PostToolUse": [{ "hooks": [null], "timeout": 86400 }]
          },
          "spawnClaudeCodeProcess": true
        }
      }
    },
    { "type": "expect_outbound", "port": "claude:1", "payload": { "method": "supportedModels" } },
    {
      "type": "runtime_exit",
      "port": "claude:1/supportedModels",
      "code": null,
      "error": "Error: Cannot write to terminated process"
    },
    { "type": "expect_outbound", "port": "claude:1", "payload": { "method": "close" } }
  ]
}

            {
              "name": "approve",
              "description": "Approves a run that waits for approval. Requires operate permission.",
              "inputSchema": {
                "type": "object",
                "properties": { "runId": { "type": "string" } },
                "required": ["runId"],
                "additionalProperties": true
              }
            }
          ]
        }
      }

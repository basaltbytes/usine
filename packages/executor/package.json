{
  "name": "@usine/executor",
  "version": "0.0.1",
  "description": "The usine five-operation worker contract and Node local executor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/executor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "default": "./dist/local/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@usine/core": "workspace:*",
    "@usine/run-host": "workspace:*"
  },
  "devDependencies": {
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@usine/executor",
  "version": "0.2.1",
  "description": "The usine scoped Worker contract with local, exe.dev, and SSH adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/executor"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/executor.d.ts",
      "default": "./dist/executor.js"
    },
    "./exe-dev": {
      "types": "./dist/exe-dev/exe-dev.d.ts",
      "default": "./dist/exe-dev/exe-dev.js"
    },
    "./local": {
      "types": "./dist/local/local.d.ts",
      "default": "./dist/local/local.js"
    },
    "./ssh": {
      "types": "./dist/ssh/ssh.d.ts",
      "default": "./dist/ssh/ssh.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@usine/agents": "workspace:*",
    "@usine/core": "workspace:*",
    "@usine/durable": "workspace:*",
    "@usine/gateway": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

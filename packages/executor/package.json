{
  "name": "@usine/executor",
  "version": "0.6.0",
  "description": "The usine scoped Worker contract with local, exe.dev, SSH, and Cloudflare adapters.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/executor"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/executor.d.ts",
      "default": "./dist/executor.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/cloudflare.d.ts",
      "default": "./dist/cloudflare/cloudflare.js"
    },
    "./exe-dev": {
      "types": "./dist/exe-dev/exe-dev.d.ts",
      "default": "./dist/exe-dev/exe-dev.js"
    },
    "./local": {
      "types": "./dist/local/local.d.ts",
      "default": "./dist/local/local.js"
    },
    "./ssh": {
      "types": "./dist/ssh/ssh.d.ts",
      "default": "./dist/ssh/ssh.js"
    },
    "./gateway": {
      "types": "./dist/ssh/gateway/model-route.d.ts",
      "default": "./dist/ssh/gateway/model-route.js"
    },
    "./supervisor": {
      "types": "./dist/supervisor/supervisor.d.ts",
      "default": "./dist/supervisor/supervisor.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "effect-tsgo tsc -p tsconfig.check.json",
    "test": "vitest run",
    "boxd:generate": "buf generate src/ssh/provisioner/boxd/proto --template src/ssh/provisioner/boxd/proto/buf.gen.yaml && mv src/ssh/provisioner/boxd/api_pb.ts src/ssh/provisioner/boxd/api-pb.ts && oxfmt src/ssh/provisioner/boxd/api-pb.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@usine/agents": "workspace:*",
    "@usine/cloudflare": "workspace:*",
    "@usine/core": "workspace:*",
    "@usine/durable": "workspace:*",
    "@usine/gateway": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/ws": "8.18.2",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "8.22.2"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

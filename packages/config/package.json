{
  "name": "@usine/config",
  "version": "0.1.0",
  "description": "Config file machinery for usine: parse, validate, and surgically rewrite the instance repo's files — usine.yaml, loop files, agent files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./instance-folder": {
      "types": "./dist/instance-folder.d.ts",
      "default": "./dist/instance-folder.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./payload-slices": {
      "types": "./dist/payload-slices.d.ts",
      "default": "./dist/payload-slices.js"
    },
    "./selector": {
      "types": "./dist/selector.d.ts",
      "default": "./dist/selector.js"
    },
    "./yaml/writer": {
      "types": "./dist/yaml/writer.d.ts",
      "default": "./dist/yaml/writer.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@usine/core": "workspace:*",
    "@usine/expression": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@usine/tsconfig": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

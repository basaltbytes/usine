{
  "name": "@usine/config",
  "version": "0.4.0",
  "description": "Versioned configuration for usine: domain validation, revision stores, and instance folder import and export.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/usine.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "drizzle"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./instance-folder": {
      "types": "./dist/instance-folder.d.ts",
      "default": "./dist/instance-folder.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./payload-slices": {
      "types": "./dist/payload-slices.d.ts",
      "default": "./dist/payload-slices.js"
    },
    "./selector": {
      "types": "./dist/selector.d.ts",
      "default": "./dist/selector.js"
    },
    "./yaml/writer": {
      "types": "./dist/yaml/writer.d.ts",
      "default": "./dist/yaml/writer.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "default": "./dist/file.js"
    },
    "./board": {
      "types": "./dist/board.d.ts",
      "default": "./dist/board.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "default": "./dist/label.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "default": "./dist/loop.js"
    },
    "./trigger": {
      "types": "./dist/trigger.d.ts",
      "default": "./dist/trigger.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./instance": {
      "types": "./dist/instance/instance.d.ts",
      "default": "./dist/instance/instance.js"
    },
    "./configuration": {
      "types": "./dist/configuration/store.d.ts",
      "default": "./dist/configuration/store.js"
    },
    "./memory": {
      "types": "./dist/configuration/memory.d.ts",
      "default": "./dist/configuration/memory.js"
    },
    "./sqlite": {
      "types": "./dist/configuration/sqlite/store.d.ts",
      "default": "./dist/configuration/sqlite/store.js"
    },
    "./folder-codec": {
      "types": "./dist/configuration/folder.d.ts",
      "default": "./dist/configuration/folder.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs"
  },
  "dependencies": {
    "@usine/core": "workspace:*",
    "@usine/expression": "workspace:*",
    "drizzle-orm": "catalog:",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@usine/tsconfig": "workspace:*",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}

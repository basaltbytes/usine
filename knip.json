{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@earendil-works/pi-codemode", "@effect/platform-node-shared"],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/agents": {
      "entry": ["protocol-conformance/check.ts"]
    },
    "tooling/oxlint": {
      "project": ["**/*.ts"]
    },
    "tooling/tsconfig": {
      "entry": [],
      "project": []
    },
    "apps/docs": {
      "ignoreDependencies": ["^@usine/"]
    },
    "apps/server": {
      "ignoreDependencies": ["@usine/web"]
    },
    "apps/web": {
      "entry": [
        "src/index.ts",
        "src/components/ui/*.tsx",
        "src/components/ai-elements/*.tsx",
        "src/hooks/*.ts"
      ],
      "ignoreIssues": {
        "src/route-tree.gen.ts": ["types"]
      }
    }
  }
}

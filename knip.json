{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["codex", "diff"],
  "ignoreDependencies": [
    "@earendil-works/chord",
    "@earendil-works/pi-agent-core",
    "@earendil-works/pi-codemode",
    "@earendil-works/pi-mcp",
    "@earendil-works/pi-telemetry",
    "@earendil-works/pi-tui",
    "@effect/platform-node-shared"
  ],
  "workspaces": {
    ".": {
      "entry": ["infra/hetzner/gateway/apply.mjs", "scripts/effect-diagnostics/*.mjs"],
      "project": []
    },
    "packages/agents": {
      "entry": [
        "protocol-conformance/check.ts",
        "src/child-host/worker/owner.ts",
        "src/child-host/worker/lifeline.ts"
      ]
    },
    "packages/cloudflare": {
      "entry": ["src/worker.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "tooling/oxlint": {
      "entry": ["plugin.ts"],
      "project": ["**/*.ts"]
    },
    "tooling/tsconfig": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["@effect/language-service"]
    },
    "apps/docs": {
      "ignoreDependencies": ["@usine/orchestrator"]
    },
    "apps/server": {
      "ignoreDependencies": ["@usine/web"]
    },
    "apps/web": {
      "entry": ["src/components/ui/*.tsx", "src/components/ai-elements/*.tsx", "src/hooks/*.ts"],
      "ignoreIssues": {
        "src/route-tree.gen.ts": ["types"]
      }
    },
    "packages/engine": {
      "entry": ["src/database/sqlite-reader/worker.ts"]
    },
    "packages/executor": {
      "ignoreIssues": {
        "src/ssh/provisioner/boxd/api-pb.ts": ["exports", "types"]
      }
    }
  }
}
